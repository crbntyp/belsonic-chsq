# Database Configuration - Development/Demo (localhost + carbontype.co)
LOCAL_DB_HOST=your_dev_db_host
LOCAL_DB_NAME=your_dev_db_name
LOCAL_DB_USER=your_dev_db_user
LOCAL_DB_PASS=your_dev_db_password

# Database Configuration - Production (client's live site)
PROD_DB_HOST=your_prod_db_host
PROD_DB_NAME=your_prod_db_name
PROD_DB_USER=your_prod_db_user
PROD_DB_PASS=your_prod_db_password

# Database Charset
DB_CHARSET=utf8mb4

# Application Settings
APP_ENV=development
APP_TIMEZONE=Europe/London
DEFAULT_VENUE_ID=6

# Admin Authentication (Fallback if admin_users table doesn't exist)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_password

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the values above with your actual credentials
# 3. Never commit .env to version control
