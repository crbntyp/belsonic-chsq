{
  "name": "shine-festivals",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:scss": "sass src/styles:dist/styles --no-source-map",
    "build:php": "cpx \"src/**/*.php\" dist",
    "build:admin-css": "cpx \"src/admin/**/*.css\" dist/admin",
    "build:js": "cpx \"src/scripts/**/*.js\" dist/scripts",
    "build:img": "cpx \"src/img/**/*\" dist/img",
    "build:fonts": "cpx \"node_modules/line-awesome/dist/line-awesome/fonts/**/*\" dist/fonts && cpx \"src/fonts/**/*\" dist/fonts",
    "build": "npm run build:scss && npm run build:php && npm run build:admin-css && npm run build:js && npm run build:img && npm run build:fonts",
    "watch:scss": "sass src/styles:dist/styles --no-source-map --watch",
    "watch:php": "cpx \"src/**/*.php\" dist --watch",
    "watch:admin-css": "cpx \"src/admin/**/*.css\" dist/admin --watch",
    "watch:js": "cpx \"src/scripts/**/*.js\" dist/scripts --watch",
    "watch:img": "cpx \"src/img/**/*\" dist/img --watch",
    "watch": "concurrently \"npm run watch:scss\" \"npm run watch:php\" \"npm run watch:admin-css\" \"npm run watch:js\" \"npm run watch:img\"",
    "serve": "php -S localhost:8080 -t dist",
    "serve:livereload": "node livereload-server.js",
    "dev": "npm run build && concurrently \"npm run watch:scss\" \"npm run watch:php\" \"npm run watch:admin-css\" \"npm run watch:js\" \"npm run watch:img\" \"npm run serve\" \"npm run serve:livereload\"",
    "dev:docker": "npm run build && concurrently \"npm run watch:scss\" \"npm run watch:php\" \"npm run watch:admin-css\" \"npm run watch:js\" \"npm run watch:img\"",
    "docker:start": "./docker-dev.sh start",
    "docker:stop": "./docker-dev.sh stop",
    "docker:restart": "./docker-dev.sh restart",
    "docker:rebuild": "./docker-dev.sh rebuild",
    "docker:logs": "./docker-dev.sh logs",
    "clean": "rm -rf dist/* && mkdir -p dist"
  },
  "keywords": [],
  "author": "Belsonic, CHSQ, Shine.net",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cpx": "^1.5.0",
    "live-server": "^1.2.2",
    "livereload": "^0.10.3",
    "sass": "^1.93.2"
  },
  "dependencies": {
    "line-awesome": "^1.3.0"
  }
}
